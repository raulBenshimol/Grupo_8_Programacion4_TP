        <mxCell id="pmfMu8N9O4-VM-HCqrM5-8" value="&lt;b&gt;Conexión al namespace&lt;/b&gt;&lt;br&gt;Connection string con SharedAccessKeyName=All y EntityPath=grupo8, guardado en user-secrets.&lt;br&gt;Tópico: en appsettings.json.&lt;div&gt;Para conectarse al broker no se usa un token del AuthServer, sino la clave del connection string.&lt;/div&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1">
