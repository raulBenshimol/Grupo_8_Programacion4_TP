@model AvailabilitySite.Models.ReservasViewModel
@using System.Text.Json

@{
    ViewData["Title"] = "Disponibilidad de asientos";

    var autenticado = User.Identity?.IsAuthenticated == true;

    // Datos del usuario autenticado.
    var correoUsuario = autenticado
        ? User.Identity?.Name
        : null;

    // Mensajes provenientes del controlador MVC.
    var mensaje = TempData["Mensaje"] as string;
    var error = TempData["Error"] as string;
    var resultadoSeguimiento = TempData["ResultadoSeguimiento"] as string;
    var solicitudConsultada = TempData["SolicitudConsultada"] as string;
    var solicitudNueva = TempData["NuevaSolicitudId"] as string;

    // Datos para mostrar el seguimiento de la reserva.
    var estado = "Sin información";
    var mensajeEstado = "No se pudo obtener el estado de la reserva.";
    var colorEstado = "secondary";
    var reservaId = "";
    var motivoRechazo = "";

    // Interpretar la respuesta del GET REST de Booking.
    if (!string.IsNullOrWhiteSpace(resultadoSeguimiento))
    {
        try
        {
            using var documento = JsonDocument.Parse(resultadoSeguimiento);
            var raiz = documento.RootElement;

            if (raiz.TryGetProperty("Booking", out var booking) &&
                booking.ValueKind == JsonValueKind.Object)
            {
                if (booking.TryGetProperty("id", out var propiedadId) &&
                    propiedadId.ValueKind == JsonValueKind.String)
                {
                    reservaId = propiedadId.GetString() ?? "";
                }

                if (booking.TryGetProperty("status", out var propiedadEstado) &&
                    propiedadEstado.ValueKind == JsonValueKind.String)
                {
                    estado = propiedadEstado.GetString() ?? "Sin información";
                }

                if (booking.TryGetProperty(
                    "rejectionMotive", out var propiedadMotivo) &&
                    propiedadMotivo.ValueKind == JsonValueKind.String)
                {
                    motivoRechazo = propiedadMotivo.GetString() ?? "";
                }

                switch (estado.ToLowerInvariant())
                {
                    case "confirmada":
                        colorEstado = "success";
                        mensajeEstado = "Tu reserva fue confirmada correctamente.";
                        break;

                    case "retenida":
                        colorEstado = "warning";
                        mensajeEstado = "Tu asiento se encuentra reservado temporalmente. Booking continúa procesando la solicitud.";
                        break;

                    case "pendiente":
                    case "pendientepago":
                        colorEstado = "warning";
                        mensajeEstado = "Tu solicitud todavía está en proceso.";
                        break;

                    case "rechazada":
                        colorEstado = "danger";
                        mensajeEstado = "Booking rechazó tu solicitud de reserva.";
                        break;

                    case "vencida":
                        colorEstado = "secondary";
                        mensajeEstado = "La retención de tu reserva venció.";
                        break;

                    default:
                        colorEstado = "secondary";
                        mensajeEstado = "El estado de la reserva no está disponible.";
                        break;
                }
            }
        }
        catch (JsonException)
        {
            // Mostrar un estado neutral si la respuesta no es válida.
        }
    }
}

<div class="container mt-4 mb-5">

    <h2>Disponibilidad de asientos</h2>

    <p class="text-muted">
        Seleccioná un evento para consultar sus asientos y su disponibilidad.
    </p>

    @* Mensajes generales *@
    @if (!string.IsNullOrWhiteSpace(error))
    {
        <div class="alert alert-danger" role="alert">
            @error
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(mensaje))
    {
        <div class="alert alert-success" role="status">
            @mensaje
        </div>
    }

    @* Solicitud enviada *@
    @if (autenticado && !string.IsNullOrWhiteSpace(solicitudNueva))
    {
        <div class="card border-primary mb-4">
            <div class="card-body">

                <h5 class="card-title">
                    Solicitud de reserva enviada
                </h5>

                <p class="mb-2">
                    Tu solicitud fue recibida.
                    Booking determinará el resultado de la reserva.
                </p>

                <p class="mb-3">
                    <strong>Identificador:</strong>
                    <code style="overflow-wrap:anywhere;">@solicitudNueva</code>
                </p>

                <form asp-controller="ReservasMvc"
                      asp-action="ConsultarEstado"
                      method="post">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="eventoId"
                           value="@Model.EventoId" />

                    <input type="hidden"
                           name="solicitudId"
                           value="@solicitudNueva" />

                    <button type="submit" class="btn btn-primary">
                        Consultar estado de mi reserva
                    </button>
                </form>

            </div>
        </div>
    }

    @* Seguimiento de una reserva *@
    @if (!string.IsNullOrWhiteSpace(resultadoSeguimiento))
    {
        <div class="card shadow-sm mb-4">
            <div class="card-body p-4">

                <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-3">

                    <div>
                        <h5 class="card-title mb-1">
                            Estado de tu reserva
                        </h5>

                        <p class="text-muted small mb-0">
                            Información consultada en Booking.
                        </p>
                    </div>

                    <span class="badge bg-@colorEstado">
                        @estado
                    </span>
                </div>

                <div class="alert alert-@colorEstado mb-3"
                     role="status">
                    @mensajeEstado
                </div>

                @if (autenticado && !string.IsNullOrWhiteSpace(correoUsuario))
                {
                    <div class="mb-3">
                        <p class="small text-muted mb-1">
                            Usuario autenticado
                        </p>

                        <p class="fw-semibold mb-0">
                            @correoUsuario
                        </p>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(motivoRechazo))
                {
                    <p class="mb-3">
                        <strong>Motivo del rechazo:</strong>
                        @motivoRechazo
                    </p>
                }

                <hr />

                @if (!string.IsNullOrWhiteSpace(solicitudConsultada))
                {
                    <p class="small text-muted mb-1">
                        Identificador de solicitud
                    </p>

                    <div class="bg-light border rounded p-2 mb-3">
                        <code style="overflow-wrap:anywhere;">
                            @solicitudConsultada
                        </code>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(reservaId))
                {
                    <p class="small text-muted mb-1">
                        Identificador de reserva en Booking
                    </p>

                    <div class="bg-light border rounded p-2">
                        <code style="overflow-wrap:anywhere;">
                            @reservaId
                        </code>
                    </div>
                }

            </div>
        </div>
    }

    @* Seleccionar evento *@
    <form asp-controller="ReservasMvc"
          asp-action="Index"
          method="get"
          class="mb-4">

        <label for="eventoId" class="form-label">
            Seleccionar evento
        </label>

        <select id="eventoId"
                name="eventoId"
                class="form-select mb-3"
                onchange="this.form.submit()">

            <option value="1" selected="@(Model.EventoId == 1)">
                Evento de prueba 1
            </option>

            <option value="2" selected="@(Model.EventoId == 2)">
                Evento de prueba 2
            </option>

            <option value="3" selected="@(Model.EventoId == 3)">
                Evento de prueba 3
            </option>

        </select>

    </form>

    @* Listado de asientos: renderizado con Partial View *@
    <h4>Asientos — Evento @Model.EventoId</h4>

    <div id="contenedor-asientos">
        <partial name="_ListaAsientos" model="Model" />
    </div>

    @* Consulta de reservas anteriores *@
    <div class="mt-5">
        <hr />

        <details>
            <summary class="h5" style="cursor:pointer;">
                Consultar una reserva anterior
            </summary>

            <div class="mt-3">

                <p class="text-muted">
                    Ingresá el identificador de una solicitud anterior
                    para consultar su estado.
                </p>

                @if (autenticado)
                {
                    <form asp-controller="ReservasMvc"
                          asp-action="ConsultarEstado"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="eventoId"
                               value="@Model.EventoId" />

                        <div class="mb-3">

                            <label for="solicitudId"
                                   class="form-label">
                                Identificador de solicitud
                            </label>

                            <input type="text"
                                   id="solicitudId"
                                   name="solicitudId"
                                   class="form-control"
                                   placeholder="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
                                   value="@solicitudConsultada"
                                   required />

                        </div>

                        <button type="submit"
                                class="btn btn-secondary">
                            Consultar estado
                        </button>

                    </form>
                }
                else
                {
                    <button type="button"
                            class="btn btn-secondary"
                            onclick="alert('Debés iniciar sesión para consultar tus reservas.')">
                        Consultar estado
                    </button>
                }

            </div>
        </details>
    </div>

</div>

@section Scripts {
    <script>
        // Polling visual: consulta únicamente la Partial View.
        (() => {
            const contenedor = document.getElementById("contenedor-asientos");

            const url = '@Url.Action("AsientosParcial", "ReservasMvc")';
            const eventoId = '@Model.EventoId';

            let actualizando = false;

            async function actualizarAsientos() {

                // Evitar consultas simultáneas o con la pestaña oculta.
                if (!contenedor || actualizando || document.hidden) {
                    return;
                }

                actualizando = true;

                try {
                    const parametros = new URLSearchParams({
                        eventoId: eventoId
                    });

                    const respuesta = await fetch(
                        `${url}?${parametros.toString()}`,
                        {
                            method: "GET",
                            cache: "no-store",
                            credentials: "same-origin"
                        }
                    );

                    if (!respuesta.ok) {
                        throw new Error(`HTTP ${respuesta.status}`);
                    }

                    const html = await respuesta.text();

                    // Actualizar solo cuando el HTML cambie.
                    if (contenedor.innerHTML.trim() !== html.trim()) {
                        contenedor.innerHTML = html;
                    }
                }
                catch (error) {
                    console.warn(
                        "Error al actualizar los asientos:",
                        error
                    );
                }
                finally {
                    actualizando = false;
                }
            }

            // Actualizar la lista cada cinco segundos.
            const intervalo = setInterval(actualizarAsientos, 5000);

            // Actualizar al regresar a la pestaña.
            document.addEventListener("visibilitychange", () => {
                if (!document.hidden) {
                    actualizarAsientos();
                }
            });

            // Detener el polling al abandonar la página.
            window.addEventListener("pagehide", () => {
                clearInterval(intervalo);
            });
        })();
    </script>
}
